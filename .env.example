# ══════════════════════════════════════════════════════════════════════════════
#  CineBook — Variables d'environnement
#  Copie ce fichier en ".env" et remplis tes valeurs réelles.
#  Ne commite JAMAIS le fichier ".env" dans Git !
# ══════════════════════════════════════════════════════════════════════════════

# ── TMDb ────────────────────────────────────────────────────────────────────────
# Obtiens ta clé sur https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Gemini API (enrichissement LLM des tags au Jalon 1) ────────────────────────
# Obtiens ta clé sur https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Backend FastAPI (utilisé au Jalon 3) ───────────────────────────────────────
DATABASE_URL=sqlite:///./cinebook.db

# ── Frontend (utilisé au Jalon 4) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
